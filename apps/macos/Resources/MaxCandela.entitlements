<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires the sandbox. The gamma/EDR APIs we use are
	     public CoreGraphics/AppKit — no extra entitlements needed;
	     CGSetDisplayTransferByTable is verified working in the sandboxed
	     build. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- StoreKit purchases -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
