<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- xcodebuild -exportArchive options for the Mac App Store upload.
	     Used by the CLI path in CLAUDE.md "Build / run / test"; the Xcode
	     Organizer GUI path needs nothing from here. Nothing secret: the team
	     ID is already in project.yml. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>YU66583SCF</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Version/build come from project.yml + Info.plist; never let the
	     export step renumber them behind our back. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
