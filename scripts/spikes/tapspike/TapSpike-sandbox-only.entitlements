<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Control run: the sandbox WITHOUT audio-input, to show whether that
	     entitlement is actually required (ENTITLEMENTS=TapSpike-sandbox-only.entitlements). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
